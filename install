#!/bin/sh

set -euf
cd "$(dirname "$0")"

link() {
    src="$1"
    dst="$2"
    mkdir -p "$(dirname "$dst")"
    ln -sf "$src" "$dst"
}

link "$PWD/.editorconfig"           "$HOME"
link "$PWD/config.fish"             "$HOME/.config/fish"
link "$PWD/config.ghostty"          "$HOME/.config/ghostty"
link "$PWD/gitconfig"               "$HOME/.config/git"
link "$PWD/gitignore"               "$HOME/.config/git"
link "$PWD/htoprc"                  "$HOME/.config/htop"
link "$PWD/init.lua"                "$HOME/.config/nvim"
link "$PWD/librewolf.overrides.cfg" "$HOME/.librewolf"
link "$PWD/starship.toml"           "$HOME/.config"

if [ ! -d "$HOME/.config/ghostty/shaders" ]; then
    git clone https://github.com/sahaj-b/ghostty-cursor-shaders "$HOME/.config/ghostty/shaders"
fi

if [ "$(uname)" = "Linux" ]; then
    link "$PWD/niri.kdl" "$HOME/.config/niri/config.kdl"

    sudo ln -sf "$PWD/keyd.conf" /etc/keyd/default.conf

    # Enable the notch.
    sudo grubby --args=appledrm.show_notch=1 --update-kernel=ALL

    # Unbind the "Do Not Disturb" key.
    if ! grep -Fxq 'HandleSuspendKey=ignore' /etc/systemd/logind.conf; then
        printf 'HandleSuspendKey=ignore\n' | sudo tee --append /etc/systemd/logind.conf > /dev/null
    fi
fi

if [ "$(uname)" = "Darwin" ]; then
    link "$PWD/karabiner.json" "$HOME/.config/karabiner"
    link "$PWD/paneru.toml"    "$HOME/.config/paneru"

    sudo ln -sf "$PWD/bin/toggle_dark_mode" /usr/local/bin

    if [ "$SHELL" != "/opt/homebrew/bin/fish" ]; then
        sudo chsh -s /opt/homebrew/bin/fish "$USER"
    fi
fi
