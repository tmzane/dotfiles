#!/bin/sh

set -euf
cd "$(dirname "$0")"

link() {
    src="$1"
    dst="$2"
    mkdir -p "$(dirname "$dst")"
    ln -sf "$src" "$dst"
}

link "$PWD/.editorconfig"           "$HOME/.editorconfig"
link "$PWD/alacritty.toml"          "$HOME/.config/alacritty/alacritty.toml"
link "$PWD/config.fish"             "$HOME/.config/fish/config.fish"
link "$PWD/config.ghostty"          "$HOME/.config/ghostty/config.ghostty"
link "$PWD/gitconfig"               "$HOME/.config/git/config"
link "$PWD/gitignore"               "$HOME/.config/git/ignore"
link "$PWD/htoprc"                  "$HOME/.config/htop/htoprc"
link "$PWD/librewolf.overrides.cfg" "$HOME/.librewolf/librewolf.overrides.cfg"
link "$PWD/nvim.lua"                "$HOME/.config/nvim/init.lua"
link "$PWD/starship.toml"           "$HOME/.config/starship.toml"

if [ ! -d "$HOME/.config/ghostty/shaders" ]; then
    git clone https://github.com/sahaj-b/ghostty-cursor-shaders "$HOME/.config/ghostty/shaders"
fi

if [ "$(uname)" = "Linux" ]; then
    link "$PWD/niri.kdl"      "$HOME/.config/niri/config.kdl"
    link "$PWD/noctalia.toml" "$HOME/.config/noctalia/config.toml"

    sudo ln -sf "$PWD/keyd.conf" /etc/keyd/default.conf

    # Enable the notch.
    sudo grubby --args=appledrm.show_notch=1 --update-kernel=ALL

    # Unbind the "Do Not Disturb" key.
    if ! grep -Fxq 'HandleSuspendKey=ignore' /etc/systemd/logind.conf; then
        printf 'HandleSuspendKey=ignore\n' | sudo tee --append /etc/systemd/logind.conf > /dev/null
    fi
fi

if [ "$(uname)" = "Darwin" ]; then
    link "$PWD/karabiner.json" "$HOME/.config/karabiner/karabiner.json"
    link "$PWD/paneru.toml"    "$HOME/.config/paneru/paneru.toml"

    sudo ln -sf "$PWD/bin/toggle_dark_mode" /usr/local/bin/toggle_dark_mode

    if [ "$SHELL" != "/opt/homebrew/bin/fish" ]; then
        sudo chsh -s /opt/homebrew/bin/fish "$USER"
    fi
fi
